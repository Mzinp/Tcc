{
  "expo": {
    "name": "Vizzo",
    "slug": "Vizzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/img/logo.png",
    "scheme": "vizzo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/img/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/img/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.isaarg96.Vizzo"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/img/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df697c6e-0a3e-4ac6-bd9d-8ad7d7f99a96"
      }
    }
  }
}
